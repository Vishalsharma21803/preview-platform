NODE_ENV=development
PORT=18081
DATABASE_URL=postgres://preview:preview@127.0.0.1:55432/preview_platform
DEPLOYMENT_TOKEN=replace-with-a-long-random-token
ALLOWED_IMAGE_NAMESPACE=your-github-owner/your-frontend-repository
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_SCHEME=http
PREVIEW_PORT=18080
TRAEFIK_NETWORK=preview-platform-runtime
ROUTES_DIR=/absolute/path/to/preview-platform/infra/routes
HEALTH_CHECK_PATH=/healthz
WORKER_POLL_MS=1000
MAX_ACTIVE_PREVIEWS=10
DEFAULT_TTL_HOURS=24
MAX_TTL_HOURS=168
PREVIEW_MEMORY=256m
PREVIEW_CPUS=0.5
PREVIEW_PIDS_LIMIT=128
